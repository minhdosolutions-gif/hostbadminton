rules_version = '2';

// ============================================================================
//  HOST BADMINTON — FIRESTORE SECURITY RULES
// ============================================================================
//  Nguyên tắc bắt buộc (mục 20 trong bản kế hoạch):
//  - Không bao giờ để "allow read, write: if true" cho toàn bộ database.
//  - Users: chỉ tự sửa hồ sơ của chính mình.
//  - Teams: đăng nhập mới tạo được; chỉ OWNER/ADMIN mới sửa.
//  - Members: chỉ OWNER/ADMIN mới thêm/xóa/đổi vai trò; thành viên đọc được
//    danh sách thành viên của ĐÚNG đội mình đang ở (phục vụ tab Thành viên).
//  - Join Requests: người dùng tự tạo yêu cầu cho chính mình; chỉ OWNER/ADMIN
//    mới đọc/duyệt/từ chối.
//  - Messages (chat đội): CHỈ thành viên đội mới đọc/gửi. Không có chat riêng
//    1-1 nên không có collection nào khác chứa tin nhắn cá nhân.
//  - Courts / Schedules: mọi thành viên đọc được, chỉ OWNER/ADMIN mới sửa.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hàm tiện ích dùng chung ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Có phải thành viên (bất kỳ vai trò nào) của đội teamId không
    function isTeamMember(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    // Vai trò của mình trong đội teamId ('OWNER' | 'ADMIN' | 'MEMBER')
    function myRoleIn(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role;
    }

    function isTeamManager(teamId) {
      return isTeamMember(teamId) && myRoleIn(teamId) in ['OWNER', 'ADMIN'];
    }

    function isTeamOwner(teamId) {
      return isTeamMember(teamId) && myRoleIn(teamId) == 'OWNER';
    }

    // ==========================================================
    // USERS — hồ sơ cá nhân (Zalo, trình độ)
    // ==========================================================
    match /users/{uid} {
      // Cho phép người dùng đã đăng nhập đọc hồ sơ công khai phù hợp (tên, avatar,
      // trình độ, Zalo nếu allowZaloContact=true) — việc lọc field nhạy cảm phía
      // client tự xử lý; ở tầng rules chỉ chặn ghi vào hồ sơ người khác.
      allow read: if isSignedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if false;
    }

    // ==========================================================
    // MATCHES — Feed kèo vãng lai thật (mục 1-2 bản Production)
    // ==========================================================
    match /matches/{matchId} {
      // Ai đã đăng nhập cũng xem được Feed (mọi khu vực) — lọc theo tỉnh/thành làm ở client
      allow read: if isSignedIn();
      // Chỉ tạo bài đăng nhân danh chính mình (hostId phải là uid của người gọi)
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      // Chỉ chủ kèo (host) mới sửa được bài của mình (duyệt/hủy duyệt applicant sẽ chỉnh needMale/needFemale ở đây)
      allow update: if isSignedIn() && resource.data.hostId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      // ---------- APPLICANTS (người xin tham gia 1 kèo cụ thể) ----------
      match /applicants/{applicantUid} {
        // Người dùng tự tạo yêu cầu xin tham gia cho chính mình
        allow create: if isSelf(applicantUid) && request.resource.data.uid == applicantUid;
        // Đọc: chính người xin HOẶC chủ kèo (để xem danh sách applicants trong tab Quản lý)
        allow read: if isSelf(applicantUid) ||
          get(/databases/$(database)/documents/matches/$(matchId)).data.hostId == request.auth.uid;
        // Duyệt/từ chối/hủy duyệt: chỉ chủ kèo được đổi status; người xin tự hủy (xóa) yêu cầu của mình
        allow update: if get(/databases/$(database)/documents/matches/$(matchId)).data.hostId == request.auth.uid;
        allow delete: if isSelf(applicantUid) ||
          get(/databases/$(database)/documents/matches/$(matchId)).data.hostId == request.auth.uid;
      }
    }

    // ==========================================================
    // TEAMS — thông tin đội (công khai để "Khám phá đội")
    // ==========================================================
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isTeamManager(teamId);
      allow delete: if isTeamOwner(teamId);

      // ---------- MEMBERS ----------
      match /members/{memberUid} {
        // Đọc: chính mình (để loadMyTeams collectionGroup query) HOẶC đang là
        // thành viên đúng đội này (để xem tab "Thành viên")
        allow read: if isSelf(memberUid) || isTeamMember(teamId);

        // Ghi: OWNER/ADMIN quản lý thành viên (thêm khi duyệt, xóa khi đá ai đó),
        // hoặc chính người đó tự xóa mình (chức năng "Rời đội")
        allow create: if isTeamManager(teamId);
        allow update: if isTeamManager(teamId);
        allow delete: if isTeamManager(teamId) || isSelf(memberUid);
      }

      // ---------- JOIN REQUESTS ----------
      match /joinRequests/{requestUid} {
        // Người dùng tạo yêu cầu cho chính mình
        allow create: if isSelf(requestUid) && request.resource.data.uid == requestUid;
        // Chỉ OWNER/ADMIN đọc danh sách chờ duyệt + chính người gửi xem lại yêu cầu của mình
        allow read: if isSelf(requestUid) || isTeamManager(teamId);
        // Duyệt/từ chối: chỉ OWNER/ADMIN (approveJoinRequest/rejectJoinRequest đều xóa doc này)
        allow update, delete: if isTeamManager(teamId) || isSelf(requestUid);
      }

      // ---------- COURTS (Sân) ----------
      match /courts/{courtId} {
        allow read: if isTeamMember(teamId);
        allow create, update, delete: if isTeamManager(teamId);
      }

      // ---------- SCHEDULES (Lịch chơi) ----------
      match /schedules/{scheduleId} {
        allow read: if isTeamMember(teamId);
        allow create, update, delete: if isTeamManager(teamId);
      }

      // ---------- MESSAGES (Chat đội — CHỈ thành viên, KHÔNG chat riêng) ----------
      match /messages/{messageId} {
        allow read: if isTeamMember(teamId);
        // Chỉ được gửi tin nhân danh chính mình
        allow create: if isTeamMember(teamId) && request.resource.data.senderId == request.auth.uid;
        // OWNER/ADMIN được xóa tin nhắn vi phạm; ai gửi thì người đó cũng tự xóa được tin của mình
        allow delete: if isTeamManager(teamId) || (isTeamMember(teamId) && resource.data.senderId == request.auth.uid);
        allow update: if false; // Không cho sửa tin nhắn đã gửi (giữ lịch sử trung thực)
      }
    }
  }
}
