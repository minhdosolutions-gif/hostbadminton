rules_version = '2';

// ============================================================================
//  HOST BADMINTON — FIRESTORE SECURITY RULES
// ============================================================================
//  Nguyên tắc bắt buộc (mục 20 trong bản kế hoạch):
//  - Không bao giờ để "allow read, write: if true" cho toàn bộ database.
//  - Users: chỉ tự sửa hồ sơ của chính mình.
//  - Teams: đăng nhập mới tạo được; chỉ OWNER/ADMIN mới sửa.
//  - Members: chỉ OWNER/ADMIN mới thêm/xóa/đổi vai trò; thành viên đọc được
//    danh sách thành viên của ĐÚNG đội mình đang ở (phục vụ tab Thành viên).
//  - Join Requests: người dùng tự tạo yêu cầu cho chính mình; chỉ OWNER/ADMIN
//    mới đọc/duyệt/từ chối.
//  - Messages (chat đội): CHỈ thành viên đội mới đọc/gửi. Không có chat riêng
//    1-1 nên không có collection nào khác chứa tin nhắn cá nhân.
//  - Courts / Schedules: mọi thành viên đọc được, chỉ OWNER/ADMIN mới sửa.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hàm tiện ích dùng chung ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Có phải thành viên (bất kỳ vai trò nào) của đội teamId không
    function isTeamMember(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    // Vai trò của mình trong đội teamId ('OWNER' | 'ADMIN' | 'MEMBER')
    function myRoleIn(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role;
    }

    function isTeamManager(teamId) {
      return isTeamMember(teamId) && myRoleIn(teamId) in ['OWNER', 'ADMIN'];
    }

    function isTeamOwner(teamId) {
      return isTeamMember(teamId) && myRoleIn(teamId) == 'OWNER';
    }

    // Cho phép 1 user tự thêm/xóa ĐÚNG uid của họ trong mảng applicantIds của match,
    // và KHÔNG được đụng vào bất kỳ field nào khác (chống sửa khống needMale/needFemale...).
    // Đây là điều kiện bắt buộc để Guest (không phải host) "Xin tham gia" / "Hủy xin" hoạt động được.
    function onlySelfApplicantIdsChange() {
      let beforeIds = resource.data.applicantIds;
      let afterIds = request.resource.data.applicantIds;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantIds']) &&
        (
          afterIds.removeAll(beforeIds).hasOnly([request.auth.uid]) ||   // tự thêm mình (Xin tham gia)
          beforeIds.removeAll(afterIds).hasOnly([request.auth.uid])     // tự rút mình (Hủy xin)
        );
    }

    // Cho phép Host xác nhận quyền của mình lên 1 match bằng cách get() thẳng lên document gốc —
    // dùng làm PHƯƠNG ÁN DỰ PHÒNG cho các applicant doc cũ (tạo từ trước khi có field hostId riêng),
    // để "Xóa kèo" không bị kẹt chỉ vì 1 doc cũ thiếu field. Phải khai báo Ở CẤP CAO NHẤT NÀY —
    // Firestore Rules KHÔNG cho phép khai báo function lồng bên trong 1 khối match cụ thể.
    function isHostOfMatch(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data.hostId == request.auth.uid;
    }

    // ==========================================================
    // USERS — hồ sơ cá nhân (Zalo, trình độ)
    // ==========================================================
    match /users/{uid} {
      // Cho phép người dùng đã đăng nhập đọc hồ sơ công khai phù hợp (tên, avatar,
      // trình độ, Zalo nếu allowZaloContact=true) — việc lọc field nhạy cảm phía
      // client tự xử lý; ở tầng rules chỉ chặn ghi vào hồ sơ người khác.
      allow read: if isSignedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if false;

      // ---------- NOTIFICATIONS (mục 4) ----------
      // Bất kỳ ai đã đăng nhập cũng "tạo hộ" thông báo cho người khác được (Host báo cho Guest,
      // Guest báo cho Host, hệ thống báo mời vào đội...) — vì app không dùng Cloud Functions trung
      // gian. Đổi lại, CHỈ chủ nhân hồ sơ (uid) mới được đọc/đánh dấu đã đọc/xóa thông báo của mình.
      match /notifications/{notifId} {
        allow create: if isSignedIn();
        allow read, update, delete: if isSelf(uid);
      }
    }

    // ==========================================================
    // MATCHES — Feed kèo vãng lai thật (mục 1-2 bản Production)
    // ==========================================================
    match /matches/{matchId} {
      // Ai đã đăng nhập cũng xem được Feed (mọi khu vực) — lọc theo tỉnh/thành làm ở client
      allow read: if isSignedIn();
      // Chỉ tạo bài đăng nhân danh chính mình (hostId phải là uid của người gọi)
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      // Host sửa toàn quyền bài của mình (duyệt/từ chối, xóa slot, đánh dấu hết hạn...)
      // HOẶC bất kỳ ai đã đăng nhập tự thêm/rút chính uid của họ khỏi applicantIds (Xin tham gia / Hủy xin)
      allow update: if isSignedIn() && (resource.data.hostId == request.auth.uid || onlySelfApplicantIdsChange());
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      // ---------- APPLICANTS (người xin tham gia 1 kèo cụ thể — tương đương "requests") ----------
      // Mỗi doc applicant lưu kèm sẵn field hostId để đỡ tốn 1 lượt đọc get() cho đa số trường hợp.
      // Nhưng những applicant được TẠO TỪ TRƯỚC (lúc code chưa lưu field này) sẽ thiếu hostId — nếu chỉ
      // dựa vào resource.data.hostId thì Host sẽ KHÔNG xóa được các doc cũ đó, kéo theo cả thao tác
      // "Xóa kèo" (xóa cả subcollection applicants trong 1 batch) bị chặn hoàn toàn dù chỉ 1 doc cũ lỗi.
      // → Luôn có thêm phương án dự phòng isHostOfMatch() (khai báo ở đầu file) để áp dụng được cho
      // MỌI applicant kể cả loại cũ thiếu field.
      match /applicants/{applicantUid} {
        // Bất kỳ ai đã đăng nhập cũng tạo được yêu cầu — nhưng chỉ cho chính mình
        allow create: if isSignedIn() && isSelf(applicantUid) && request.resource.data.uid == applicantUid;
        // Đọc: chính người xin HOẶC đúng chủ kèo của bài này
        allow read: if isSelf(applicantUid) || (isSignedIn() && (resource.data.hostId == request.auth.uid || isHostOfMatch(matchId)));
        // Duyệt/từ chối: CHỈ chủ kèo (host) của bài đăng này mới được sửa
        allow update: if isSignedIn() && (resource.data.hostId == request.auth.uid || isHostOfMatch(matchId));
        // Xóa: chủ kèo (từ chối/hủy duyệt/xóa cả kèo) HOẶC chính người xin tự rút yêu cầu
        allow delete: if isSelf(applicantUid) || (isSignedIn() && (resource.data.hostId == request.auth.uid || isHostOfMatch(matchId)));
      }
    }

    // ==========================================================
    // TEAMS — thông tin đội (công khai để "Khám phá đội")
    // ==========================================================
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isTeamManager(teamId);
      allow delete: if isTeamOwner(teamId);

      // ---------- MEMBERS ----------
      match /members/{memberUid} {
        // Đọc: chính mình (để loadMyTeams collectionGroup query) HOẶC đang là
        // thành viên đúng đội này (để xem tab "Thành viên")
        allow read: if isSelf(memberUid) || isTeamMember(teamId);

        // Ghi: OWNER/ADMIN quản lý thành viên (thêm khi duyệt, xóa khi đá ai đó),
        // hoặc chính người đó tự xóa mình (chức năng "Rời đội").
        // Riêng CREATE có thêm trường hợp đặc biệt: lúc "Tạo đội" xong, người tạo cần tự ghi
        // bản ghi members/{ownerUid} của CHÍNH MÌNH với role OWNER đầu tiên — lúc đó isTeamManager()
        // luôn = false vì bản ghi OWNER chưa tồn tại (exists() chưa thấy gì) → nếu chỉ dùng
        // isTeamManager() thì KHÔNG BAO GIỜ tạo được đội. Vì vậy cho phép thêm 1 ngoại lệ: tự tạo
        // đúng bản ghi của chính mình với role OWNER, và document teams/{teamId} (đã tạo trước đó
        // trong cùng luồng createTeam()) xác nhận đúng mình là ownerId.
        allow create: if isTeamManager(teamId) ||
          (isSelf(memberUid) && request.resource.data.role == 'OWNER' &&
           get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid);
        allow update: if isTeamManager(teamId);
        allow delete: if isTeamManager(teamId) || isSelf(memberUid);
      }

      // ---------- JOIN REQUESTS ----------
      match /joinRequests/{requestUid} {
        // Người dùng tạo yêu cầu cho chính mình
        allow create: if isSelf(requestUid) && request.resource.data.uid == requestUid;
        // Chỉ OWNER/ADMIN đọc danh sách chờ duyệt + chính người gửi xem lại yêu cầu của mình
        allow read: if isSelf(requestUid) || isTeamManager(teamId);
        // Duyệt/từ chối: chỉ OWNER/ADMIN (approveJoinRequest/rejectJoinRequest đều xóa doc này)
        allow update, delete: if isTeamManager(teamId) || isSelf(requestUid);
      }

      // ---------- COURTS (Sân) ----------
      match /courts/{courtId} {
        allow read: if isTeamMember(teamId);
        allow create, update, delete: if isTeamManager(teamId);
      }

      // ---------- SCHEDULES (Lịch chơi) ----------
      match /schedules/{scheduleId} {
        allow read: if isTeamMember(teamId);
        allow create, update, delete: if isTeamManager(teamId);
      }

      // ---------- MESSAGES (Chat đội — CHỈ thành viên, KHÔNG chat riêng) ----------
      match /messages/{messageId} {
        allow read: if isTeamMember(teamId);
        // Chỉ được gửi tin nhân danh chính mình
        allow create: if isTeamMember(teamId) && request.resource.data.senderId == request.auth.uid;
        // OWNER/ADMIN được xóa tin nhắn vi phạm; ai gửi thì người đó cũng tự xóa được tin của mình
        allow delete: if isTeamManager(teamId) || (isTeamMember(teamId) && resource.data.senderId == request.auth.uid);
        allow update: if false; // Không cho sửa tin nhắn đã gửi (giữ lịch sử trung thực)
      }
    }
  }
}
